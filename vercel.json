{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/shared/:path*",
      "destination": "/shared/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "admin.bugu.co.za"
        }
      ],
      "destination": "/admin/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/app/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.bugu.co.za"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "has": [
        {
          "type": "host",
          "value": "admin.bugu.co.za"
        }
      ],
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.bugu.co.za"
        }
      ],
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
